/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# These filenames are NOT content-hashed, so they must never be marked immutable.
# A browser told "immutable" will not re-request the file for a year, while the HTML
# that depends on it keeps updating every deploy - which silently breaks the site for
# returning visitors. must-revalidate costs one conditional request that answers 304
# when nothing changed.
/assets/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/site.js
  Cache-Control: public, max-age=0, must-revalidate

# Images are large and change rarely, so they get a real cache - but a bounded one,
# not immutable, for the same reason.
/assets/portrait.webp
  Cache-Control: public, max-age=604800

/assets/portrait-small.webp
  Cache-Control: public, max-age=604800

/assets/social-profile.jpg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
