{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ttbarton",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Serve 404.html for unmatched paths instead of a bare 404
    "not_found_handling": "404-page"
  }
}
